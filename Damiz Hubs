-- Movimentação com limite de tela
local dragging, dragInput, dragStart, startPos

local function updateLogoInput(input)
	local delta = input.Position - dragStart
	local newOffsetX = startPos.X.Offset + delta.X
	local newOffsetY = startPos.Y.Offset + delta.Y

	local viewportSize = camera.ViewportSize
	local maxX = math.max(0, viewportSize.X - logoButton.AbsoluteSize.X)
	local maxY = math.max(0, viewportSize.Y - logoButton.AbsoluteSize.Y)

	local clampedX = math.clamp(newOffsetX, 0, maxX)
	local clampedY = math.clamp(newOffsetY, 0, maxY)

	logoButton.Position = UDim2.new(0, clampedX, 0, clampedY)
end

logoButton.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPos = logoButton.Position

		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end
end)

logoButton.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
		dragInput = input
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if input == dragInput and dragging then
		updateLogoInput(input)
	end
end)

