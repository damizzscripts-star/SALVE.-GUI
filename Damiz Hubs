-- Função para reordenar alfabeticamente e renderizar a lista
renderList = function()
	for _, child in ipairs(scrollList:GetChildren()) do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end

	table.sort(savedScripts, function(a, b)
		return tostring(a.Name):lower() < tostring(b.Name):lower()
	end)

	for _, item in ipairs(savedScripts) do
		addScriptToUI(item)
	end
end

renderList()

