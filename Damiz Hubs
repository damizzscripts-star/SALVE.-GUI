-- Ação STORAGE
storageButton.Activated:Connect(function()
	local codeText = scriptTextBox.Text
	local scriptName = nameTextBox.Text:gsub("%s+", "")

	if codeText:gsub("%s+", "") ~= "" then
		for _, item in ipairs(savedScripts) do
			if item.Code == codeText then
				warn("[Storage]: Este script já está salvo no armazenamento!")
				return
			end
		end

		if scriptName == "" then
			local count = #savedScripts + 1
			scriptName = "SCRIPT" .. string.format("%.1f", count)
		end

		local newScriptData = {
			Name = scriptName,
			Code = codeText
		}

		table.insert(savedScripts, newScriptData)
		saveScriptsToFile()
		renderList()
		
		nameTextBox.Text = ""
		scriptTextBox.Text = ""
	end
end)
