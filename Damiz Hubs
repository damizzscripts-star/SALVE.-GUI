local isOpen = false
local tweenInfo = TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)

local function togglePanel()
	isOpen = not isOpen
	
	if isOpen then
		mainFrame.Size = UDim2.new(0, 440, 0, 0)
		mainFrame.Visible = true
		
		local tween = TweenService:Create(mainFrame, tweenInfo, {Size = UDim2.new(0, 440, 0, 320)})
		tween:Play()
	else
		local tween = TweenService:Create(mainFrame, tweenInfo, {Size = UDim2.new(0, 440, 0, 0)})
		tween:Play()
		tween.Completed:Connect(function()
			if not isOpen then
				mainFrame.Visible = false
			end
		end)
	end
end

