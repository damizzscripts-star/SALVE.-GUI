-- Configuração do armazenamento local permanente
local FOLDER_NAME = "MyScriptStorage"
local FILE_PATH = FOLDER_NAME .. "/saved_scripts.json"

local savedScripts = {}

local function saveScriptsToFile()
	if writefile then
		pcall(function()
			if isfolder and not isfolder(FOLDER_NAME) and makefolder then
				makefolder(FOLDER_NAME)
			end
			writefile(FILE_PATH, HttpService:JSONEncode(savedScripts))
		end)
	end
end

local function loadScriptsFromFile()
	if readfile and isfile and isfile(FILE_PATH) then
		pcall(function()
			local data = readfile(FILE_PATH)
			local decoded = HttpService:JSONDecode(data)
			if type(decoded) == "table" then
				savedScripts = decoded
			end
		end)
	end
end

